{
  "name": "byc-t-shape-qip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/rules.test.ts",
    "test:rules": "vitest run tests/rules.test.ts",
    "test:rules:emu": "firebase emulators:exec --only firestore,storage --project demo-byc-qip \"npm run test:rules\"",
    "dev:emu": "firebase emulators:exec --only auth,firestore,storage --project demo-byc-qip \"node scripts/seed-emulator.mjs && vite --mode emulator\"",
    "prepare": "husky"
  },
  "dependencies": {
    "firebase": "^10.14.0",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "husky": "^9.1.7",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^1.6.0"
  }
}
